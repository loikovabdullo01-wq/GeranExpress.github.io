rules_version = '2';

// Starter security rules for listing photos in Firebase Storage.
// Deploy with: firebase deploy --only storage
//
// Model: photos are publicly readable (they're shown in listings to
// everyone), but a user can only upload into their own folder
// (listings/<their-uid>/...), and only images up to 8MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
