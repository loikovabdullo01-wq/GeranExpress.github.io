rules_version = '2';

// Starter security rules for the "listings" collection.
// Deploy with: firebase deploy --only firestore:rules
// (after `firebase login` and `firebase use <your-project-id>` in this folder).
//
// Model: anyone (even logged-out visitors) can read listings so the
// feed stays public. Only a signed-in user can create a listing, and
// only the listing's own owner (userId == their auth uid) can edit
// or delete it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /listings/{listingId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['userId', 'amount', 'bank', 'account', 'message', 'receiptUrl', 'createdAt', 'updatedAt'])
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // Online presence: one doc per browser tab/session, refreshed by a heartbeat.
    // No auth required (anonymous visitors are counted too); writes are limited
    // to just the lastSeen timestamp so this can't be abused to store other data.
    match /presence/{sessionId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['lastSeen'])
                    && request.resource.data.lastSeen is timestamp;
      allow delete: if true;
    }

    // Settings & Custom Banners management
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
